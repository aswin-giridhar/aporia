# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# === PRIMARY PROVIDER: Alibaba Cloud / Qwen Cloud (DashScope) ==============
# The intended path, and the one this project is built around.
#
# MUST be a PAY-AS-YOU-GO key (prefix sk- or sk-ws-), created at
#   https://home.qwencloud.com/api-keys
#
# A Token Plan key (prefix sk-sp-) will NOT work here, and not merely for
# technical reasons: its terms prohibit "automated scripts, application
# backends, or non-interactive batch processing" — exactly this workload.
# Token Plan keys also live on a different host entirely
# (token-plan.ap-southeast-1.maas.aliyuncs.com) and return 401 on dashscope.
DASHSCOPE_API_KEY=

# Optional, only for subscription keys. One of: token | coding
# Leave unset for pay-as-you-go.
# QWEN_PLAN=


# === FALLBACK PROVIDER: OpenRouter =========================================
# Used ONLY when DashScope entitlement is unavailable. OpenRouter serves the
# same Qwen models via a different vendor, which lets the benchmark produce
# REAL measurements of model behaviour instead of hand-written fixtures.
#
# IMPORTANT: this is not a substitute for Alibaba Cloud. Results obtained this
# way are labelled with the provider that produced them in every table and
# results file. Presenting OpenRouter output as Alibaba Cloud usage would be
# misrepresentation, so the labelling is enforced in code, not left to prose.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=


# === RUN MODE ==============================================================
# Provider selection: dashscope (default) | openrouter
# QWEN_PROVIDER=dashscope

# Run with no credentials at all — simulated agents, zero network, zero spend.
# Output is labelled FIXTURE DATA and is never presented as a finding.
# QWEN_MODE=mock
